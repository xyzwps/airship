{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/shell/*.ts",
    "src/shell/*.tsx",
    "src/shell/*.d.ts",
    "src/sdk/**/*.ts",
    "src/sdk/**/*.tsx",
    "src/apps/**/*.ts",
    "src/apps/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx"
  ],
  "exclude": [
    "src/**/tests/**",
    "src/**/specs/**",
    "src/**/__tests__/**"
  ]
}
