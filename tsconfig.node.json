{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@apps/*": [
        "src/apps/*"
      ]
    }
  },
  "include": [
    "src/shell/main/**/*.ts",
    "src/shell/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/apps/*/app.ts",
    "electron.vite.config.ts"
  ],
  "exclude": [
    "src/**/tests/**",
    "src/**/specs/**",
    "src/**/__tests__/**"
  ]
}
